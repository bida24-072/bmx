{
  "name": "@bmx/core",
  "version": "0.1.0",
  "description": "BMX Digital Rails — Warehouse Receipt Core (GGDS-compliant, FinX-ready)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "schema:generate": "tsx scripts/generate-json-schema.ts",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "zod-to-json-schema": "^3.23.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED",
  "private": true
}
